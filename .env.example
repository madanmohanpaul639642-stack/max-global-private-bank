# ========================================================
# Max Global Private Bank Management System — Environment Configuration
# ========================================================

# Application Runtime
PORT=3000
NODE_ENV=production

# Session Security (Generate a strong 64-character random string for production)
SESSION_SECRET=change_me_to_a_random_64_char_hex_secret_in_production

# Account Seeding Configuration (Set to 'false' in production if you do not want demo accounts seeded)
SEED_DEMO_ACCOUNTS=true
INITIAL_ADMIN_PASSWORD=change_me_to_a_strong_admin_password
INITIAL_TELLER_PASSWORD=change_me_to_a_strong_teller_password
INITIAL_CUSTOMER_PASSWORD=change_me_to_a_strong_customer_password

# Database Engine Selection: 'auto' (tries MySQL then SQLite fallback), 'mysql', or 'sqlite'
DB_TYPE=sqlite

# Local MySQL or Cloud SQL Settings (Only required if DB_TYPE=mysql or auto)
DB_HOST=localhost
DB_PORT=3306
DB_USER=max_bank_user
DB_PASSWORD=change_me_db_password
DB_NAME=max_global_bank

# Google Cloud SQL Connection Name (Optional for Cloud Run Unix Socket)
# CLOUD_SQL_CONNECTION_NAME=your-project:asia-south1:max-global-db

# Google Cloud Gemini AI Configuration (Optional: fallback AI activates automatically if empty)
# Obtain your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT_ID=max-global-bank-cloud
GOOGLE_CLOUD_REGION=asia-south1
